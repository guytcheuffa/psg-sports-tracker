# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Env & secrets
.env

# Data (raw/processed non versionnes, structure gardee via .gitkeep)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.duckdb

# Assets visuels (logo/banniere club, photos joueurs) : usage local/prive
# uniquement (images/marques protegees), cf. app/theme.py.
data/assets/players/*
!data/assets/players/.gitkeep
data/assets/branding/*
!data/assets/branding/.gitkeep

# Notebooks checkpoints
.ipynb_checkpoints/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/*
!.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db
