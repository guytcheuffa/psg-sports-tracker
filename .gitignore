# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Env & secrets
.env

# Data (raw/processed non versionnes, structure gardee via .gitkeep)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.duckdb

# Photos joueurs : usage local/prive uniquement par defaut (photos de
# personnes identifiables, droit a l'image), cf. app/theme.py.
data/assets/players/*
!data/assets/players/.gitkeep

# Logo/banniere club (data/assets/branding/) : publies volontairement par
# l'utilisateur (portfolio personnel, usage non commercial), cf. app/theme.py.

# Notebooks checkpoints
.ipynb_checkpoints/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/*
!.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db
